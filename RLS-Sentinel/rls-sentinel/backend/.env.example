# Copy to .env and adjust as needed. Never commit the real .env.
DATABASE_URL=sqlite:///./rls_sentinel.db
# For docker-compose / Postgres:
# DATABASE_URL=postgresql+psycopg://rls:rls@db:5432/rls_sentinel

RATE_LIMIT_RPS=5
SCAN_REQUEST_RATE_LIMIT=10/minute
HTTP_TIMEOUT_SECONDS=10
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
